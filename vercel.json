{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/auth"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/auth/:path*"
    },
    {
      "source": "/nfc",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/nfc"
    },
    {
      "source": "/nfc/:path*",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/nfc/:path*"
    },
    {
      "source": "/functions/v1/:path*",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
