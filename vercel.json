{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/auth"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/auth/:path*"
    },
    {
      "source": "/nfc",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/nfc"
    },
    {
      "source": "/nfc/:path*",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/nfc/:path*"
    },
    {
      "source": "/functions/v1/:path*",
      "destination": "https://jklfqmbaubvnbrbuhzak.supabase.co/functions/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://jklfqmbaubvnbrbuhzak.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://jklfqmbaubvnbrbuhzak.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
