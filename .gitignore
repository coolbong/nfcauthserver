# ==============================================================================
# NFC Authentication 보안 인증 시스템 .gitignore
# ==============================================================================

# 1. Environment variables & Secrets (보안 필수)
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx

# 2. Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Java / Maven / JavaCard build artifacts
**/target/
target/
*.class
*.cap
*.war
*.ear
ndef-applet/build/bin/
ndef-applet/logs/
**/logs/
*.log

# 4. JavaCard SDKs, Ant distribution & large binaries
tools/
**/tools/

# 5. IDE & Editor configurations
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/
**/.vscode/
.classpath
.project
.settings/
.apt_generated/
.springBeans
.sts4-cache
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# 6. Python temporary & cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# 7. Supabase CLI temporary files
supabase/.temp/
.temp/

# 8. Operating System files
.DS_Store
Thumbs.db
Desktop.ini
